# Copy to .env and enter the connection values from the Aiven console.
# Do not commit .env or paste credentials into chat.
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Download the Aiven project CA certificate to backend/certs/aiven-ca.pem.
DB_SSL_ENABLED=true
DB_SSL_CA_FILE=certs/aiven-ca.pem

# Replace with a random secret of at least 32 characters.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Leave API docs disabled in production. Enable only for local development.
ENABLE_DOCS=false

# CIDRs of reverse proxies whose forwarded headers may be trusted for rate
# limiting. Leave empty unless the app runs behind a proxy you control.
# Example: TRUSTED_PROXY_IPS=173.245.48.0/20,103.21.244.0/22
TRUSTED_PROXY_IPS=
